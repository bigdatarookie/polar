# This example contains no passwords. Create the password file outside the repo.
POLAR_DB_PASSWORD_PATH=/private/tmp/polar-bootstrap-secrets/db_password
POLAR_API_PORT=18080
POLAR_NETWORK=polar_fixture_service
POLAR_API_NETWORK=polar_fixture_api
POLAR_CODE_REVISION=UNRECORDED
POLAR_IMAGE_TAG=fixture
POLAR_DB_VOLUME=polar_fixture_db
POLAR_ARTIFACT_VOLUME=polar_fixture_artifacts
POLAR_EVALUATION_VOLUME=polar_fixture_evaluations
# Set a selected completed run/attempt directory for the isolated evaluator.
POLAR_EVALUATOR_INPUT=/private/tmp/polar-selected-evaluator-input
# Current app storage allocation in bytes; shared local Polar ceiling is 64 GiB.
POLAR_STORAGE_BYTES=68719476736
# Dedicated persistent random 32-byte file outside Git; never reuse DB credentials.
POLAR_HISTORY_CURSOR_KEY_PATH=/private/tmp/polar-history-secrets/cursor.key
