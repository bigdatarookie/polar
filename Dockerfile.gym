# Local dependency tag must first be verified against the frozen composition receipt.
ARG GYM_DEPENDENCIES=polar-local:gym-deps-nautilus-1.231.0
FROM ${GYM_DEPENDENCIES}
ENV PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER root
WORKDIR /app
COPY src /app/src
COPY pyproject.toml /app/pyproject.toml
RUN python -c "from pathlib import Path; p=Path('/usr/local/bin/polar'); p.write_text('#!/usr/local/bin/python\nfrom polar.cli import main\nif __name__ == \"__main__\": main()\n'); p.chmod(0o555)"
USER 10001
ENTRYPOINT ["python", "-m", "polar.cli"]
CMD ["--help"]
